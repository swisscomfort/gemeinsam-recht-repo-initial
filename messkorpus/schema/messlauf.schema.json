{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gemeinsam-recht/messkorpus/messlauf.schema.json",
  "title": "Messlauf — vollstaendige Trefferliste einer Messdefinition",
  "description": "Ein Lauf haelt jeden einzelnen Treffer der Abfrage dauerhaft fest. Jeder Treffer traegt genau einen Status; ein Ausschluss traegt zwingend einen in der Messdefinition vorher deklarierten Grund. Es gibt keinen stillen Verlust: roh_treffer muss der Laenge der Trefferliste entsprechen, und ein gekappter Abruf ist kein gueltiger Messlauf.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "messdefinition",
    "durchgefuehrt_am",
    "datenstand",
    "roh_treffer",
    "gekappt",
    "treffer"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^ML-[0-9]{3}$" },
    "messdefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^MD-[0-9]{3}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "durchgefuehrt_am": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "datenstand": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "roh_treffer": { "type": "integer", "minimum": 0 },
    "gekappt": { "type": "boolean" },
    "treffer": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quelle_id", "status"],
        "properties": {
          "quelle_id": { "type": "string", "minLength": 1 },
          "aktenzeichen": { "type": "string" },
          "datum": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "gericht": { "type": "string" },
          "link": { "type": "string" },
          "status": { "enum": ["eingeschlossen", "ausgeschlossen", "ungeklaert"] },
          "ausschlussgrund": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "notiz": { "type": "string" },
          "story_id": { "type": "string", "pattern": "^FS-[0-9]{3}$" }
        }
      }
    }
  }
}
