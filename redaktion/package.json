{
  "name": "@gemeinsam-recht/redaktion",
  "version": "0.1.0",
  "private": true,
  "description": "Internes Beschaffungswerkzeug (AUFTRAG-R0): holt Metadaten und Links oeffentlich publizierter Schweizer Gerichtsentscheide von entscheidsuche.ch als Kandidatenliste fuer die Redaktion. Keine Volltext-Archivierung, keine Veroeffentlichung, kein LLM.",
  "type": "module",
  "scripts": {
    "kandidaten": "tsc -p tsconfig.build.json && node dist/kandidaten.js",
    "sieben": "tsc -p tsconfig.build.json && node dist/sieben.js",
    "messlauf-erheben": "tsc -p tsconfig.build.json && node dist/messlauf-erheben.js",
    "volltexte-holen": "tsc -p tsconfig.build.json && node dist/volltexte-holen.js",
    "volltexte-abschliessen": "tsc -p tsconfig.build.json && node dist/volltexte-abschliessen.js",
    "kodierstoff-export": "tsc -p tsconfig.build.json && node dist/kodierstoff-export.js",
    "kodierung-export": "tsc -p tsconfig.build.json && node dist/kodierung-export.js",
    "kodierung-import": "tsc -p tsconfig.build.json && node dist/kodierung-import.js",
    "test": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
